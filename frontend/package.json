{
  "name": "yummy-flow-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "api:types": "openapi-typescript api/openapi.json -o types/schema.ts",
    "format:check": "prettier --check app components features lib api/client.ts types/model.ts"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "openapi-typescript": "^7.0.0",
    "@playwright/test": "^1.58.0",
    "prettier": "^3.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
