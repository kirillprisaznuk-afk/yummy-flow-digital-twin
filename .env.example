# Synthetic LOCAL ONLY configuration; copy to ignored .env and change the password.
# Keep the password in the URLs consistent. Use URL-safe characters.
POSTGRES_USER=yummy_flow
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://yummy_flow:replace_me@127.0.0.1:5433/yummy_flow
# Use a dedicated disposable database; tests create their own temporary schema.
YUMMY_TEST_POSTGRES_URL=postgresql+psycopg://yummy_flow:replace_me@127.0.0.1:5433/yummy_flow_test
# Compose loads .env; Python does not. scripts/backend.ps1 loads it on Windows.
# Run `python -m app.database.migrate` before starting the API.
# For local development without PostgreSQL:
# DATABASE_URL=sqlite:///./yummy_flow.db
